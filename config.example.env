# Пример файла конфигурации
# Скопируйте этот файл в .env и настройте под свои нужды.
# Python не загружает .env автоматически. Compose передаёт в контейнер только
# переменные, объявленные в environment/env_file. В примере есть исторические
# ключи, которые текущий код не читает; список действующих настроек:
# docs/DEVELOPMENT.md, раздел «Конфигурация приложения».

# Flask настройки
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Режим Flask-SocketIO: threading (рекомендуется), без eventlet/gevent
SOCKETIO_ASYNC_MODE=threading

# Настройки приложения
MAX_CONTENT_LENGTH=17179869184  # 16GB в байтах
UPLOAD_FOLDER=/app/uploads
OUTPUT_FOLDER=/app/outputs
LOG_FOLDER=/app/logs

# Разрешённые корни для сохранения готовой копии на сервер, через запятую.
# Default /anilibria; явно пустое значение отключает сохранение.
# Для примера с bind-mount /mnt/user/anilibria-encoded:/exports в docker-compose.yml:
# INTERNAL_OUTPUT_ROOTS=/exports
# Основной Compose, Unraid и registry-варианты уже передают переменную в контейнер.
# В остальных Compose вариантах объявите эту переменную в environment вручную.

# Настройки FFmpeg
FFMPEG_THREADS=4
FFMPEG_PRESET=slow
FFMPEG_CRF=23
# Начальный лимит параллельных encode (fallback, если ещё не сохранён в UI /settings)
# Runtime-значение задаётся на странице «Настройки» и пишется в app_settings.json
MAX_CONCURRENT_ENCODES=1
# Каталог бинарников в контейнере (том ffmpeg_bin)
# FFMPEG_DIR=/app/ffmpeg
# Абсолютные пути к своим бинарникам (пропуск автозагрузки)
# FFMPEG_BIN=/app/ffmpeg/bin/ffmpeg
# FFPROBE_BIN=/app/ffmpeg/bin/ffprobe
# Полный URL архива вместо BtbN latest
# FFMPEG_DOWNLOAD_URL=
# Не скачивать FFmpeg (ошибка, если бинарников нет)
# FFMPEG_SKIP_DOWNLOAD=0

# Ник для блока «Обновление метаданных» (если ещё не сохранён через UI)
# METADATA_NICKNAME=GeeKaZ0iD
# Файл настроек (том settings)
# APP_SETTINGS_PATH=/app/settings/app_settings.json
# SQLite заданий и квитанций internal encode (тот же постоянный том settings)
# Путь независим от APP_SETTINGS_PATH; каталог базы должен быть доступен на запись
# JOB_STORE_PATH=/app/settings/jobs.sqlite3
# Опционально: путь к mkvpropedit (правка MIME шрифтов перед remux)
# MKVPROPEDIT_BIN=/usr/bin/mkvpropedit

# Часовой пояс контейнера (логи на диске, FFmpeg); UI показывает время браузера
TZ=Asia/Novosibirsk

# Настройки Docker
DOCKER_MEMORY_LIMIT=8g
DOCKER_CPU_LIMIT=4

# Метаданные сборки образа (опционально; скрипты build-and-push заполняют автоматически)
# BUILD_TIME=2026-08-22T16:46:00Z
# GIT_SHA=abc1234

# Приватный Docker Registry (сборка и публикация образа)
# Подробнее: registry.example.env и раздел README «Сборка и публикация образа»
REGISTRY=registry.example.com
IMAGE_NAME=al-web-video-encoder
IMAGE_TAG=latest

# Настройки логирования
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
# In-memory логи для UI (/logs); по умолчанию INFO даже при LOG_LEVEL=WARNING
MEMORY_LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Настройки безопасности
# ZIP не поддерживается — только одиночные видеофайлы (.mp4, .mkv)
ALLOWED_EXTENSIONS=mp4,mkv
MAX_FILE_SIZE=17179869184  # 16GB в байтах
