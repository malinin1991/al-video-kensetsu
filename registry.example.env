# Настройки приватного Docker Registry
# Скопируйте в registry.env или добавьте в .env в корне проекта
#
#   copy registry.example.env registry.env   (Windows)
#   cp registry.example.env registry.env     (Linux/macOS)

# URL registry без завершающего слэша
REGISTRY=registry.mageek.su

# Имя образа (репозиторий в registry)
IMAGE_NAME=al-web-video-encoder

# Тег образа (версия, git SHA, latest и т.д.)
IMAGE_TAG=latest

# Полное имя образа (формируется автоматически в скриптах):
# ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}

# Метаданные сборки (скрипты build-and-push заполняют автоматически)
# BUILD_TIME=2026-08-22T16:46:00Z
# GIT_SHA=abc1234

# Опционально: учётные данные для docker login
# REGISTRY_USER=your-username
# REGISTRY_PASSWORD=your-password-or-token

# Мультиарх-сборка (linux/amd64,linux/arm64/v8)
# MULTIARCH=0
